#!/bin/zsh
# gptimg: one GPT Image generation through Codex CLI, prompt passed verbatim.
# Uses your Codex default model (GPTIMG_MODEL=... to override). If the default is refused
# ("not supported when using Codex with a ChatGPT account", seen on an old CLI), retries on gpt-6-astra.
# usage: [GPTIMG_CROP169=1] gptimg -o out.png [-r ref.jpg]... "prompt"  (refs: image 1, image 2... in order)
set -e
out=""; size="1536x1024"; refs=()
while [[ $# -gt 1 ]]; do
  case $1 in
    -o) out=$2; shift 2;;
    -s) size=$2; shift 2;;
    -r) refs+=("--image=${2:A}"); refnames+=("$(basename $2)"); shift 2;;
    *) break;;
  esac
done
prompt=$1
[[ -z $out || -z $prompt ]] && { echo "usage: gptimg -o out.png [-s WxH] [-r ref]... prompt"; exit 2; }
outabs=${out:A}
meta="Call your image generation tool exactly ONCE. Size ${size}. Pass the prompt between the PROMPT markers to the tool VERBATIM: do not rewrite, expand or add to it."
[[ ${#refs} -gt 0 ]] && meta+=" Give the tool the attached image(s) as input images, in the order attached (${refnames[*]})."
meta+=" Then copy the generated file to ${outabs} and print only that path.
PROMPT>>>
${prompt}
<<<PROMPT"
mflag=(); [[ -n $GPTIMG_MODEL ]] && mflag=(-m "$GPTIMG_MODEL")
run() { print -r -- "$meta" | codex exec "$@" --skip-git-repo-check --sandbox workspace-write -C ${outabs:h} ${refs[@]} - 2>&1 }
log=$(run ${mflag[@]})
if [[ $log == *"not supported when using Codex"* ]]; then echo "default model refused; retrying on gpt-6-astra"; log=$(run -m gpt-6-astra); fi
print -r -- "$log" | tail -3
[[ -f $outabs ]] && file $outabs || { echo "NO FILE WRITTEN"; exit 1; }
# GPTIMG_CROP169=1: centre-crop the 3:2 output to 16:9 beside the original
if [[ -n $GPTIMG_CROP169 ]]; then
  ffmpeg -loglevel error -y -i $outabs -vf "crop=iw:iw*9/16" ${outabs:r}_16x9.png && echo ${outabs:r}_16x9.png
fi
